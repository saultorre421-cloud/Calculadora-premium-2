<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Calculadora Táctil Profesional - Caja</title>
    <style>
        /* Estilos generales a pantalla completa */
        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            height: 100vh;
            width: 100vw;
            overflow: hidden; /* Evita cualquier desplazamiento accidental */
            display: flex;
        }

        .phone-frame {
            width: 100%;
            height: 100%;
            background-color: #ffffff;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* Pantalla de la calculadora */
        .display {
            flex: 1; /* Ocupa el espacio superior disponible */
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            align-items: flex-end;
            padding: 30px 25px;
            word-break: break-all;
        }

        .d-expression {
            font-size: 54px; /* Aumentado para mayor visibilidad */
            font-weight: 500;
            color: #111;
            min-height: 65px;
            text-align: right;
            transition: all 0.2s;
            cursor: text; 
            user-select: none; 
        }

        /* Cursor Táctil y Caracteres */
        .caret {
            display: inline-block;
            width: 3px;
            background-color: #629f6b;
            height: 50px;
            vertical-align: text-bottom;
            animation: blink 1s step-end infinite;
            margin: 0 1px;
            position: relative;
            top: -4px;
            border-radius: 2px;
        }
        @keyframes blink { 
            0%, 100% { opacity: 1; }
            50% { opacity: 0; } 
        }
        .char-span {
            display: inline-block;
            cursor: text;
        }

        /* RESULTADO AUTOMÁTICO */
        .d-live-result {
            font-size: 40px; /* Aumentado para pantallas grandes */
            font-weight: 800; 
            color: #0044ff; 
            min-height: 48px;
            margin-top: 10px;
            text-align: right;
            letter-spacing: 0.5px;
        }

        /* Modal del Historial */
        .history-modal {
            position: absolute;
            top: 20px; /* Ajustado al quitar el encabezado */
            left: 15px;
            right: 15px;
            background-color: #ffffff;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            z-index: 10;
            display: flex;
            flex-direction: column;
            transition: opacity 0.3s ease, transform 0.3s ease;
            max-height: 60vh; /* Se adapta a la altura del dispositivo */
        }

        .history-modal.hidden {
            opacity: 0;
            pointer-events: none;
            transform: translateY(-10px);
        }

        .history-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-bottom: 1px solid #f0f0f0;
        }
        .history-header h2 {
            margin: 0;
            font-size: 22px;
            font-weight: bold;
        }
        
        .header-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .delete-selected-btn {
            background: none;
            border: none;
            font-size: 22px;
            cursor: pointer;
            color: #ff4d4d;
            display: none; 
            transition: transform 0.2s;
        }
        .delete-selected-btn:active { transform: scale(0.9); }

        .close-btn {
            background: none;
            border: none;
            font-size: 30px;
            font-weight: bold;
            cursor: pointer;
            color: #111;
        }

        /* Contenedor del historial */
        .history-list {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            scroll-behavior: smooth;
        }

        .history-item {
            background-color: #f9f9f9;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: background-color 0.2s;
        }
        .history-item:active { background-color: #f0f0f0; }

        .h-checkbox {
            width: 24px;
            height: 24px;
            accent-color: #629f6b;
            cursor: pointer;
        }
        
        .h-content {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            flex: 1;
            cursor: pointer; 
        }

        .h-expression {
            font-size: 18px;
            color: #555;
            margin-bottom: 6px;
        }
        .h-result {
            font-size: 24px;
            font-weight: bold;
            color: #111;
        }

        .empty-history {
            text-align: center;
            padding: 40px 20px;
            color: #aaa;
            font-style: italic;
            font-size: 18px;
        }

        /* Teclado Expandido */
        .keypad {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(5, 1fr); /* 5 filas proporcionales */
            gap: 12px;
            padding: 15px;
            background-color: #ffffff;
            border-top: 1px solid #eee;
            flex: 1.5; /* Hace que el teclado ocupe más espacio (ideal para celulares grandes) */
        }

        .key {
            font-size: 30px; /* Texto más grande */
            border: none;
            border-radius: 16px;
            cursor: pointer;
            font-family: inherit;
            transition: transform 0.1s, background-color 0.2s;
            display: flex;
            justify-content: center;
            align-items: center;
            touch-action: manipulation;
            width: 100%;
            height: 100%; /* Ocupa toda la celda asignada por el grid */
        }
        .key:active {
            transform: scale(0.92);
        }

        /* Colores de los botones */
        .key-green { background-color: #629f6b; color: #ffffff; }
        .key-num { background-color: #f3f4ef; color: #111111; font-weight: 500;}
        .key-orange { background-color: #f29c1f; color: #ffffff; font-size: 38px; font-weight: bold;}
        .key-op-large { font-size: 38px; font-weight: bold; }
        .key-equals { background-color: #629f6b; color: white; font-size: 38px; }
    </style>
</head>
<body>

<div class="phone-frame">

    <div id="historyModal" class="history-modal hidden">
        <div class="history-header">
            <h2>Historial</h2>
            <div class="header-actions">
                <button id="btnDeleteSelected" class="delete-selected-btn" onclick="deleteSelectedItems()" title="Borrar seleccionados">🗑️</button>
                <button class="close-btn" onclick="toggleHistory()">×</button>
            </div>
        </div>
        <div class="history-list" id="historyList"></div>
    </div>

    <div class="display">
        <div class="d-expression" id="d-expression" onclick="setCursor(currentExpression.length)"></div>
        <div class="d-live-result" id="d-live-result"></div>
    </div>

    <div class="keypad">
        <button class="key key-green" onclick="clearDisplay()">C</button>
        <button class="key key-green" onclick="toggleHistory()">🕒</button>
        <button class="key key-green" onclick="deleteLast()">⌫</button>
        <button class="key key-green key-op-large" onclick="appendOp('/')">÷</button>

        <button class="key key-num" onclick="appendNum('7')">7</button>
        <button class="key key-num" onclick="appendNum('8')">8</button>
        <button class="key key-num" onclick="appendNum('9')">9</button>
        <button class="key key-orange" onclick="appendOp('*')">×</button>

        <button class="key key-num" onclick="appendNum('4')">4</button>
        <button class="key key-num" onclick="appendNum('5')">5</button>
        <button class="key key-num" onclick="appendNum('6')">6</button>
        <button class="key key-orange" onclick="appendOp('-')">-</button>

        <button class="key key-num" onclick="appendNum('1')">1</button>
        <button class="key key-num" onclick="appendNum('2')">2</button>
        <button class="key key-num" onclick="appendNum('3')">3</button>
        <button class="key key-orange" onclick="appendOp('+')">+</button>

        <button class="key key-num" onclick="appendNum('00')">00</button>
        <button class="key key-num" onclick="appendNum('0')">0</button>
        <button class="key key-num" onclick="appendNum('.')">.</button>
        <button class="key key-equals" onclick="commitToHistory()">=</button>
    </div>
</div>

<script>
    let currentExpression = ""; 
    let cursorPos = 0; 
    let historyData = []; 

    const expressionEl = document.getElementById('d-expression');
    const liveResultEl = document.getElementById('d-live-result');
    const historyModal = document.getElementById('historyModal');
    const historyList = document.getElementById('historyList');
    const btnDeleteSelected = document.getElementById('btnDeleteSelected');

    updateDisplay();

    function updateDisplay() {
        let displayHTML = "";
        let rawLen = currentExpression.length;
        
        let commaPositions = new Set();
        const numRegex = /\d+(?:\.\d+)?/g;
        let match;
        while ((match = numRegex.exec(currentExpression)) !== null) {
            let numStr = match[0];
            let dotIndex = numStr.indexOf('.');
            let intPart = dotIndex === -1 ? numStr : numStr.substring(0, dotIndex);
            for (let i = intPart.length - 3; i > 0; i -= 3) {
                commaPositions.add(match.index + i);
            }
        }

        if (rawLen === 0) {
            displayHTML = `<span class="caret"></span><span style="color:#111">0</span>`;
        } else {
            for (let i = 0; i <= rawLen; i++) {
                if (i === cursorPos) {
                    displayHTML += `<span class="caret"></span>`;
                }
                
                if (i < rawLen) {
                    if (commaPositions.has(i)) {
                        displayHTML += `<span class="char-span" onclick="event.stopPropagation(); setCursor(${i})">,</span>`;
                    }
                    
                    let char = currentExpression[i];
                    let displayChar = char;
                    if (char === '*') displayChar = '×';
                    if (char === '/') displayChar = '÷';
                    
                    displayHTML += `<span class="char-span" onclick="handleCharClick(event, ${i})">${displayChar}</span>`;
                }
            }
        }
        
        expressionEl.innerHTML = displayHTML;
        liveResultEl.innerText = calculateLive();
    }

    function handleCharClick(event, index) {
        event.stopPropagation(); 
        const rect = event.target.getBoundingClientRect();
        const clientX = event.clientX || (event.touches && event.touches[0].clientX);
        const clickX = clientX - rect.left;
        
        if (clickX < rect.width / 2) {
            setCursor(index);
        } else {
            setCursor(index + 1);
        }
    }

    function setCursor(pos) {
        cursorPos = pos;
        updateDisplay();
    }

    function formatWithCommas(numberString) {
        let parts = numberString.toString().split(".");
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return parts.join(".");
    }

    function calculateLive() {
        if (!currentExpression) return "";
        try {
            let evalString = currentExpression.replace(/[\+\-\*\/]+$/, '');
            if (!/[\+\-\*\/]/.test(evalString)) return "";

            let result = eval(evalString);
            if (result === Infinity || result === -Infinity) return "Error";
            if (result !== undefined && !isNaN(result)) {
                result = Math.round(result * 100000000) / 100000000;
                return formatWithCommas(result);
            }
        } catch (error) {
            return ""; 
        }
        return "";
    }

    function appendNum(num) {
        currentExpression = currentExpression.slice(0, cursorPos) + num + currentExpression.slice(cursorPos);
        cursorPos += num.length; 
        updateDisplay();
    }

    function appendOp(op) {
        if (currentExpression === "") {
            currentExpression = "0" + op;
            cursorPos = 2;
        } else {
            let prevChar = currentExpression[cursorPos - 1];
            if (['+', '-', '*', '/'].includes(prevChar)) {
                currentExpression = currentExpression.slice(0, cursorPos - 1) + op + currentExpression.slice(cursorPos);
            } else {
                currentExpression = currentExpression.slice(0, cursorPos) + op + currentExpression.slice(cursorPos);
                cursorPos += op.length;
            }
        }
        updateDisplay();
    }

    function clearDisplay() {
        currentExpression = "";
        cursorPos = 0;
        updateDisplay();
    }

    function deleteLast() {
        if (cursorPos > 0) {
            currentExpression = currentExpression.slice(0, cursorPos - 1) + currentExpression.slice(cursorPos);
            cursorPos--;
            updateDisplay();
        }
    }

    function commitToHistory() {
        let liveResult = calculateLive();
        if (liveResult && liveResult !== "Error") {
            
            historyData.push({
                expr: currentExpression, 
                res: liveResult
            });
            
            renderHistory();
            
            currentExpression = liveResult.replace(/,/g, '');
            cursorPos = currentExpression.length;
            updateDisplay();
        }
    }

    function formatExpressionForDisplay(expr) {
        let displayExpr = expr.replace(/\*/g, '×').replace(/\//g, '÷');
        displayExpr = displayExpr.replace(/\d+(\.\d+)?/g, function(match) {
            return formatWithCommas(match);
        });
        return displayExpr;
    }

    function toggleHistory() {
        historyModal.classList.toggle('hidden');
        renderHistory();
    }

    function renderHistory() {
        historyList.innerHTML = '';
        btnDeleteSelected.style.display = 'none'; 
        
        if (historyData.length === 0) {
            historyList.innerHTML = '<div class="empty-history">No hay operaciones guardadas.</div>';
            return;
        }

        historyData.forEach((item, index) => {
            const itemDiv = document.createElement('div');
            itemDiv.className = 'history-item';
            
            itemDiv.innerHTML = `
                <input type="checkbox" class="h-checkbox" data-index="${index}" onchange="checkSelections()">
                <div class="h-content" onclick="loadFromHistory('${item.expr}')" title="Tocar para usar en calculadora">
                    <span class="h-expression">${formatExpressionForDisplay(item.expr)}</span>
                    <span class="h-result">${item.res}</span>
                </div>
            `;
            historyList.appendChild(itemDiv);
        });

        historyList.scrollTop = historyList.scrollHeight;
    }

    function checkSelections() {
        const checkboxes = document.querySelectorAll('.h-checkbox');
        let anyChecked = false;
        checkboxes.forEach(chk => { if (chk.checked) anyChecked = true; });
        btnDeleteSelected.style.display = anyChecked ? 'block' : 'none';
    }

    function deleteSelectedItems() {
        const checkboxes = document.querySelectorAll('.h-checkbox');
        let indicesToDelete = [];
        checkboxes.forEach((chk) => {
            if (chk.checked) indicesToDelete.push(parseInt(chk.getAttribute('data-index')));
        });
        indicesToDelete.sort((a, b) => b - a);
        indicesToDelete.forEach(index => { historyData.splice(index, 1); });
        renderHistory();
    }

    function loadFromHistory(expression) {
        currentExpression = expression;
        cursorPos = currentExpression.length; 
        updateDisplay();
        toggleHistory();
    }
</script>

</body>
</html>
