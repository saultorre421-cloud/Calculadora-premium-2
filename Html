<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Calculadora Táctil Profesional - Caja</title>
    <style>
        /* Estilos generales a pantalla completa */
        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            display: flex;
        }

        .phone-frame {
            width: 100%;
            height: 100%;
            background-color: #ffffff;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* Pantalla de la calculadora */
        .display {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            align-items: flex-end;
            padding: 30px 25px;
            word-break: break-all;
        }

        .d-expression {
            font-size: 54px;
            font-weight: 500;
            color: #111;
            min-height: 65px;
            text-align: right;
            transition: all 0.2s;
            cursor: text;
            user-select: none;
        }

        /* Cursor Táctil y Caracteres */
        .caret {
            display: inline-block;
            width: 3px;
            background-color: #629f6b;
            height: 50px;
            vertical-align: text-bottom;
            animation: blink 1s step-end infinite;
            margin: 0 1px;
            position: relative;
            top: -4px;
        }

        @keyframes blink {
            from, to { background-color: transparent; }
            50% { background-color: #629f6b; }
        }

        .char-node {
            cursor: pointer;
            display: inline-block;
            transition: color 0.1s;
        }
        .char-node:hover {
            color: #629f6b;
        }

        .d-result {
            font-size: 26px;
            color: #8c8c8c;
            min-height: 35px;
            margin-top: 8px;
            font-weight: 400;
        }

        /* Barra divisoria de utilidades */
        .utility-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 25px;
            border-bottom: 1px solid #f0f0f0;
        }

        .utility-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: #555;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: background 0.2s;
        }
        .utility-btn:active {
            background-color: #f2f2f2;
        }

        /* Teclado numérico y operacional */
        .keypad {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1px;
            background-color: #f7f7f7;
            padding-bottom: env(safe-area-inset-bottom, 20px);
        }

        button.key {
            background-color: #ffffff;
            border: none;
            outline: none;
            height: 78px;
            font-size: 26px;
            font-weight: 500;
            color: #1a1a1a;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            transition: background 0.1s;
        }

        button.key:active {
            background-color: #e9e9e9;
        }

        /* Colores funcionales */
        button.key.op {
            color: #2b78e4;
            font-size: 28px;
        }

        button.key.clear {
            color: #eb4d4b;
        }

        button.key.equals {
            background-color: #27ae60;
            color: white;
            font-size: 32px;
        }
        button.key.equals:active {
            background-color: #219150;
        }

        /* Modal deslizable de Historial */
        .history-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 100;
        }

        .history-panel {
            position: absolute;
            bottom: -100%;
            left: 0;
            width: 100%;
            height: 75%;
            background: #ffffff;
            border-top-left-radius: 24px;
            border-top-right-radius: 24px;
            box-shadow: 0 -5px 25px rgba(0,0,0,0.15);
            display: flex;
            flex-direction: column;
            transition: bottom 0.3s cubic-bezier(0.1, 0.9, 0.2, 1);
            box-sizing: border-box;
        }

        .history-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 24px;
            border-bottom: 1px solid #f0f0f0;
        }

        .history-header h3 {
            margin: 0;
            font-size: 18px;
            color: #333;
        }

        .history-list {
            flex: 1;
            overflow-y: auto;
            padding: 15px 24px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .history-item {
            text-align: right;
            border-bottom: 1px solid #f9f9f9;
            padding-bottom: 12px;
            cursor: pointer;
        }

        .history-item-expr {
            font-size: 16px;
            color: #777;
            margin-bottom: 4px;
        }

        .history-item-res {
            font-size: 22px;
            color: #27ae60;
            font-weight: bold;
        }

        .empty-history {
            text-align: center;
            color: #aaa;
            margin-top: 40px;
        }
    </style>
</head>
<body>

<div class="phone-frame">
    <!-- Pantalla Superior -->
    <div class="display">
        <div class="d-expression" id="displayArea"></div>
        <div class="d-result" id="liveResultArea"></div>
    </div>

    <!-- Barra de Accesos Rápidos -->
    <div class="utility-bar">
        <button class="utility-btn" onclick="toggleHistory(true)" title="Historial">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </button>
        <button class="utility-btn" onclick="handleBackspace()" title="Retroceso">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"></path><line x1="18" y1="9" x2="12" y2="15"></line><line x1="12" y1="9" x2="18" y2="15"></line></svg>
        </button>
    </div>

    <!-- Teclado Numérico -->
    <div class="keypad">
        <button class="key clear" onclick="handleClear()">C</button>
        <button class="key op" onclick="insertParentheses()">( )</button>
        <button class="key op" onclick="insertText('%')">%</button>
        <button class="key op" onclick="insertText('÷')">÷</button>

        <button class="key" onclick="insertText('7')">7</button>
        <button class="key" onclick="insertText('8')">8</button>
        <button class="key" onclick="insertText('9')">9</button>
        <button class="key op" onclick="insertText('×')">×</button>

        <button class="key" onclick="insertText('4')">4</button>
        <button class="key" onclick="insertText('5')">5</button>
        <button class="key" onclick="insertText('6')">6</button>
        <button class="key op" onclick="insertText('-')">-</button>

        <button class="key" onclick="insertText('1')">1</button>
        <button class="key" onclick="insertText('2')">2</button>
        <button class="key" onclick="insertText('3')">3</button>
        <button class="key op" onclick="insertText('+')">+</button>

        <button class="key op" onclick="insertPlusMinus()">±</button>
        <button class="key" onclick="insertText('0')">0</button>
        <button class="key" onclick="insertText('.')">.</button>
        <button class="key equals" onclick="commitToHistory()">=</button>
    </div>

    <!-- Panel de Historial Deslizable -->
    <div class="history-overlay" id="historyOverlay" onclick="toggleHistory(false)">
        <div class="history-panel" onclick="event.stopPropagation()">
            <div class="history-header">
                <h3>Historial de Cálculos</h3>
                <button class="utility-btn" onclick="clearAllHistory()" title="Borrar Historial">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eb4d4b" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </button>
            </div>
            <div class="history-list" id="historyList">
                <div class="empty-history">No hay operaciones recientes</div>
            </div>
        </div>
    </div>
</div>

<script>
    // Variables de Estado
    let currentExpression = "";
    let cursorPos = 0;
    let historyData = [];

    // URL de conexión con Google Apps Script
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbz0jWIN_loSAftgC56lUR5Yzrid3qW-qmJBqssVOUHzwZYidNSu2VLEZ-Wq8B2rq3dZ/exec";

    const displayArea = document.getElementById('displayArea');
    const liveResultArea = document.getElementById('liveResultArea');
    const historyOverlay = document.getElementById('historyOverlay');
    const historyList = document.getElementById('historyList');

    // Función asíncrona para guardar en Google Sheets
    function sendToSheets(expr, res) {
        fetch(SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                expression: expr,
                result: res
            })
        }).then(() => {
            console.log("Guardado con éxito en Google Sheets");
        }).catch(err => {
            console.error("Error al guardar en Google Sheets:", err);
        });
    }

    // Renderiza la expresión en pantalla con el cursor interactivo
    function updateDisplay() {
        displayArea.innerHTML = "";

        for (let i = 0; i <= currentExpression.length; i++) {
            if (i === cursorPos) {
                const caret = document.createElement('span');
                caret.className = 'caret';
                displayArea.appendChild(caret);
            }
            if (i < currentExpression.length) {
                const charSpan = document.createElement('span');
                charSpan.className = 'char-node';
                charSpan.innerText = currentExpression[i];
                const targetIdx = i + 1;
                charSpan.onclick = (e) => {
                    e.stopPropagation();
                    setCursor(targetIdx);
                };
                displayArea.appendChild(charSpan);
            }
        }

        displayArea.onclick = () => setCursor(currentExpression.length);
        updateLiveResult();
    }

    function setCursor(index) {
        cursorPos = Math.max(0, Math.min(index, currentExpression.length));
        updateDisplay();
    }

    // Inserción de caracteres en la posición activa del cursor
    function insertText(text) {
        currentExpression = currentExpression.slice(0, cursorPos) + text + currentExpression.slice(cursorPos);
        cursorPos += text.length;
        updateDisplay();
    }

    // Borrado individual (Backspace)
    function handleBackspace() {
        if (cursorPos > 0) {
            currentExpression = currentExpression.slice(0, cursorPos - 1) + currentExpression.slice(cursorPos);
            cursorPos--;
            updateDisplay();
        }
    }

    // Limpieza total (Clear)
    function handleClear() {
        currentExpression = "";
        cursorPos = 0;
        updateDisplay();
    }

    // Manejo contextual de Paréntesis
    function insertParentheses() {
        const leftCount = (currentExpression.match(/\(/g) \vert{}\vert{} []).length;         const rightCount = (currentExpression.match(/\)/g) || []).length;
        const lastChar = currentExpression.slice(cursorPos - 1, cursorPos);

        if (leftCount > rightCount && !['+', '-', '×', '÷', '('].includes(lastChar) && cursorPos > 0) {
            insertText(')');
        } else {
            insertText('(');
        }
    }

    // Inversión de signo (±)
    function insertPlusMinus() {
        if (!currentExpression) return;
        let start = cursorPos - 1;
        while (start >= 0 && /[0-9.]/.test(currentExpression[start])) {
            start--;
        }
        start++;
        let end = cursorPos;
        while (end < currentExpression.length && /[0-9.]/.test(currentExpression[end])) {
            end++;
        }

        let numStr = currentExpression.slice(start, end);
        if (numStr) {
            let replaced = numStr.startsWith('-') ? numStr.slice(1) : '-' + numStr;
            currentExpression = currentExpression.slice(0, start) + replaced + currentExpression.slice(end);
            cursorPos = start + replaced.length;
            updateDisplay();
        }
    }

    // Cálculo dinámico en tiempo real
    function updateLiveResult() {
        const res = calculateLive();
        if (res && res !== "Error" && currentExpression.length > 0) {
            liveResultArea.innerText = res;
        } else {
            liveResultArea.innerText = "";
        }
    }

    function calculateLive() {
        if (!currentExpression) return "";
        try {
            let sanitized = currentExpression
                .replace(/×/g, '*')
                .replace(/÷/g, '/')
                .replace(/%/g, '/100');

            if (/[+\-*\/]$/.test(sanitized)) return "";

            let total = Function('"use strict";return (' + sanitized + ')')();
            if (total !== undefined && !isNaN(total) && isFinite(total)) {
                return Number.isInteger(total) ? total.toString() : parseFloat(total.toFixed(6)).toString();
            }
            return "";
        } catch (e) {
            return "";
        }
    }

    // Guardado de operación en Historial y Google Sheets
    function commitToHistory() {
        let liveResult = calculateLive();
        if (liveResult && liveResult !== "Error") {
            historyData.push({
                expr: currentExpression,
                res: liveResult
            });
            renderHistory();

            // Enviar fila directamente a Google Sheets
            sendToSheets(currentExpression, liveResult);

            currentExpression = liveResult.replace(/,/g, '');
            cursorPos = currentExpression.length;
            updateDisplay();
        }
    }

    // Gestión del panel modal de historial
    function toggleHistory(show) {
        if (show) {
            historyOverlay.style.display = 'block';
            setTimeout(() => {
                historyOverlay.style.opacity = '1';
                document.querySelector('.history-panel').style.bottom = '0';
            }, 10);
        } else {
            historyOverlay.style.opacity = '0';
            document.querySelector('.history-panel').style.bottom = '-100%';
            setTimeout(() => {
                historyOverlay.style.display = 'none';
            }, 300);
        }
    }

    function renderHistory() {
        if (historyData.length === 0) {
            historyList.innerHTML = '<div class="empty-history">No hay operaciones recientes</div>';
            return;
        }
        historyList.innerHTML = "";
        historyData.slice().reverse().forEach(item => {
            const row = document.createElement('div');
            row.className = 'history-item';
            row.innerHTML = `<div class="history-item-expr">${item.expr} =</div>
                             <div class="history-item-res">${item.res}</div>`;
            row.onclick = () => {
                currentExpression = item.res;
                cursorPos = currentExpression.length;
                updateDisplay();
                toggleHistory(false);
            };
            historyList.appendChild(row);
        });
    }

    function clearAllHistory() {
        historyData = [];
        renderHistory();
    }

    // Inicialización al cargar la página
    updateDisplay();
</script>
</body>
</html>
